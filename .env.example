# Le Simulateur SEA vit dans le schéma `simulateur_sea` des projets Supabase du
# portail Ma Sonate (masonate-dev, -staging, -prod). Valeurs par environnement :
# tableau de bord du projet, Project Settings, API. La clé anon est publique
# (elle part dans le bundle du front) ; ne jamais mettre la clé service_role ici.
#
# En local contre la pile du portail (`npx supabase start` dans MA SONATE GROUP) :
#   VITE_SUPABASE_URL=http://127.0.0.1:54321 et la clé anon de `npx supabase status`.
VITE_SUPABASE_URL=https://fyatyljioapdjarkwpxb.supabase.co
VITE_SUPABASE_ANON_KEY=

# Le portail Ma Sonate de cet environnement (bouton « Se connecter avec Ma
# Sonate », mot de passe oublié, lien vers l'écran Équipe). Vide : liens masqués.
VITE_PORTAL_URL=https://dev.ma.sonate.group

# --- Fonction /sso (api/sso.ts), entrée depuis le portail ---
# Variables SERVEUR du projet Vercel, lues par la fonction seule. JAMAIS
# préfixées VITE_ : Vite recopierait la clé service_role dans le bundle.
# Inutiles à `npm run dev` (Vite ne sert pas api/).
SUPABASE_URL=https://fyatyljioapdjarkwpxb.supabase.co
SUPABASE_ANON=
SUPABASE_SERVICE_KEY=
# Secret de signature du ticket, PARTAGÉ avec le portail (même valeur que
# SIMULATEUR_SEA_SHARED_SECRET dans ses variables Vercel), distinct par environnement.
SIMULATEUR_SEA_SHARED_SECRET=

# --- Ancienne base Turso : lecture seule, inventaire et reprise ---
# (scripts/simulateur-sea-source-inventory.mjs). À supprimer après la bascule.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
